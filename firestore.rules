rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'candrajouva03@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSeller() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sellerStatus == 'approved')
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins metadata collection
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time;
      allow update: if isSignedIn() && (
                       (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isDeveloper', 'isOwner', 'sellerStatus', 'salesCode', 'email'])) ||
                       isAdmin()
                     );
      allow delete: if isAdmin();
    }

    // Seller registrations
    match /seller_registrations/{regId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || request.query.limit <= 50);
      allow create: if isSignedIn() &&
                       isValidId(regId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'pending_approval' &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time;
      allow update: if isSignedIn() && (
                       (resource.data.userId == request.auth.uid &&
                        existing().status in ['pending_approval', 'revision_requested'] &&
                        incoming().status == 'pending_approval' &&
                        !incoming().diff(existing()).affectedKeys().hasAny(['status', 'reviewedBy', 'reviewedAt', 'salesCode'])) ||
                       isAdmin()
                     );
      allow delete: if isAdmin();
    }

    // Owner Announcements (Top realtime notices)
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Store Promos
    match /promos/{promoId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(promoId) &&
                       (incoming().sellerId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() &&
                       ((resource.data.sellerId == request.auth.uid) || isAdmin());
    }

    // Follows
    match /follows/{followId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().followerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // Product Categories
    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Marketplace Products
    match /products/{productId} {
      allow get, list: if isSignedIn();
      // Only approved sellers or admins can create products for the marketplace
      allow create: if isSignedIn() &&
                       isValidId(productId) &&
                       incoming().sellerId == request.auth.uid &&
                       incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 250 &&
                       incoming().price is int && incoming().price >= 0 &&
                       incoming().stock is int && incoming().stock >= 0 &&
                       (incoming().moderationStatus in ['pending', 'approved', 'rejected', 'revision_requested', 'suspended']) &&
                       (isAdmin() || (isSeller() && incoming().moderationStatus == 'pending'));
      // Sellers can update/delete their own products, or admins can moderate
      allow update: if isSignedIn() &&
                       ((resource.data.sellerId == request.auth.uid) || isAdmin());
      allow delete: if isSignedIn() &&
                       ((resource.data.sellerId == request.auth.uid) || isAdmin());
    }

    // Stories (24H Social System)
    match /stories/{storyId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(storyId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().mediaType in ['PHOTO', 'VIDEO', 'TEXT', 'TESTIMONIAL', 'PRODUCT_LINKED'] &&
                       incoming().privacyMode in ['PUBLIC', 'FOLLOWERS', 'PRIVATE', 'SELECTED_ACCOUNTS', 'HIDE_FROM'] &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time;
      allow update: if isSignedIn() && (
                       resource.data.authorId == request.auth.uid ||
                       isAdmin() ||
                       incoming().diff(existing()).affectedKeys().hasOnly(['viewers', 'viewersCount', 'viewersProfiles', 'reactions', 'userReactions'])
                     );
      allow delete: if isSignedIn() &&
                       ((resource.data.authorId == request.auth.uid) || isAdmin());
    }

    // Reviews
    match /reviews/{reviewId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(reviewId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().rating >= 1 && incoming().rating <= 5;
      allow update, delete: if isSignedIn() &&
                       ((resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Content Reports
    match /reports/{reportId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Moderation Logs
    match /moderation_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(logId) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time;
      allow update, delete: if false; // immutable audit log
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time;
      allow update: if isSignedIn() && (
                       (request.auth.uid == existing().userId) ||
                       (request.auth.uid == existing().sellerId) ||
                       isAdmin()
                     );
      allow delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(paymentId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time;
      allow update: if isSignedIn() && (
                       (request.auth.uid == existing().userId) ||
                       isAdmin()
                     );
      allow delete: if isAdmin();
    }

    // Store Settings
    match /storeSettings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
