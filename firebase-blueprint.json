{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role: owner, developer, seller, user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique user ID matching auth.uid" },
        "displayName": { "type": "string", "description": "User's display name" },
        "username": { "type": "string", "description": "Unique handle" },
        "email": { "type": "string", "description": "User's email" },
        "role": { "type": "string", "enum": ["owner", "developer", "seller", "user"], "description": "Role in ZX Store" },
        "sellerStatus": { "type": "string", "enum": ["none", "pending", "approved", "rejected", "suspended"], "description": "Seller registration status" },
        "sellerRegistrationId": { "type": "string", "description": "Linked registration doc ID" },
        "shopName": { "type": "string", "description": "Approved seller shop name" },
        "shopUsername": { "type": "string", "description": "Approved seller shop handle" },
        "salesCode": { "type": "string", "description": "Unique seller sales code e.g. ZXSELL-XXXXXX" },
        "isDeveloper": { "type": "boolean", "description": "System verified developer status" },
        "isOwner": { "type": "boolean", "description": "System verified owner status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of account creation" }
      },
      "required": ["userId", "displayName", "email", "role", "createdAt"]
    },
    "SellerRegistration": {
      "title": "SellerRegistration",
      "description": "Seller registration submitted by user with Google Maps location and shop details",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Applicant UID" },
        "userEmail": { "type": "string", "description": "Applicant email" },
        "applicantName": { "type": "string", "description": "Real owner full name" },
        "shopName": { "type": "string", "description": "Store name" },
        "shopUsername": { "type": "string", "description": "Unique shop handle" },
        "shopLogoUrl": { "type": "string", "description": "Store logo" },
        "shopDescription": { "type": "string", "description": "Store description" },
        "contactPhone": { "type": "string", "description": "Seller contact WhatsApp" },
        "salesCode": { "type": "string", "description": "System-generated unique sales code" },
        "category": { "type": "string", "description": "Primary sales category" },
        "locationType": { "type": "string", "description": "STORE_FRONT or DELIVERY_AREA" },
        "placeName": { "type": "string", "description": "Google Maps place name" },
        "formattedAddress": { "type": "string", "description": "Formatted address from Google Maps" },
        "latitude": { "type": "number", "description": "Latitude coordinate" },
        "longitude": { "type": "number", "description": "Longitude coordinate" },
        "placeId": { "type": "string", "description": "Google Maps Place ID" },
        "mapsUrl": { "type": "string", "description": "Google Maps view URL" },
        "status": { "type": "string", "enum": ["pending_approval", "approved", "rejected", "revision_requested", "blocked"], "description": "Approval lifecycle status" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userEmail", "shopName", "shopUsername", "salesCode", "status", "createdAt"]
    },
    "OwnerAnnouncement": {
      "title": "OwnerAnnouncement",
      "description": "Realtime official announcements and notices from Owner/Developer",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Announcement title" },
        "content": { "type": "string", "description": "Announcement body message" },
        "imageUrl": { "type": "string", "description": "Banner visual" },
        "themeColorHex": { "type": "string", "description": "Hex color code" },
        "targetAudience": { "type": "string", "enum": ["ALL", "SELLER", "USER", "DEVELOPER"] },
        "isActive": { "type": "boolean", "description": "Active visibility" },
        "authorEmail": { "type": "string", "description": "Author email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "isActive", "createdAt"]
    },
    "StorePromo": {
      "title": "StorePromo",
      "description": "Promotional campaigns created by sellers or owner",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string", "description": "Seller UID" },
        "title": { "type": "string", "description": "Promo campaign title" },
        "promoCode": { "type": "string", "description": "Unique promo code" },
        "discountPercent": { "type": "integer", "description": "Percentage discount" },
        "isActive": { "type": "boolean", "description": "Active state" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "title", "isActive", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Store and marketplace products",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "integer" },
        "sellerId": { "type": "string" },
        "moderationStatus": { "type": "string", "enum": ["pending", "approved", "rejected", "revision_requested", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "sellerId", "moderationStatus", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" } },
    "/seller_registrations/{registrationId}": { "schema": { "$ref": "#/entities/SellerRegistration" } },
    "/announcements/{announcementId}": { "schema": { "$ref": "#/entities/OwnerAnnouncement" } },
    "/promos/{promoId}": { "schema": { "$ref": "#/entities/StorePromo" } },
    "/products/{productId}": { "schema": { "$ref": "#/entities/Product" } }
  }
}
